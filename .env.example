# Boss-Helper 环境变量配置
# 复制此文件为 .env 后修改相应值

# ===== 运行模式 =====
# prod: 生产模式，使用打包后的静态文件，无需 Node.js
# dev:  开发模式，Vite 热更新，需 Node.js 环境
BOSS_ENV=dev

# ===== 端口配置 =====
# prod 模式固定端口（不找空闲端口）
BOSS_BACKEND_PORT=8848

# dev 模式后端起始端口（被占则自动顺延）
BOSS_DEV_BACKEND_PORT=8848

# dev 模式 Vite 起始端口（被占则自动顺延）
BOSS_DEV_VITE_PORT=5173

# ===== 输出目录 =====
# dev 模式输出目录（prod 模式固定为 ~/Documents/BOSS-Helper输出/）
BOSS_OUTPUT_DIR=output/

# ===== 调试 =====
# 是否启用调试日志（写入 .cursor/debug.log）
TRACELINK_ENABLED=true

# 调试 Scope 过滤（* = 全部，或 collect-start,error 等）
TRACELINK_SCOPES=*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
src/*.egg-info/

# Browser profiles (session data, cookies, login state)
profiles/

# Output data (采集结果，不入库)
output/

# Runtime state
.cdp_port*

# Config (用户私有配置，config.example.yaml 是模板)
config.yaml

# Environment
.env
.env.local

# IDE
.vscode/
.idea/

# Logs
*.log
scraper.log

# Temp files
page_dump.html
targets.json

# Frontend (webui) - keep source, ignore deps & local npm config
webui/node_modules/
webui/.local-packages/
node_modules/
.tracelink/
webui/.tracelink
webui/dist/
webui/.npmrc
*.tsbuildinfo

# Vite build output (generated by `npm run build` → server/static/)
server/static/

# Cursor / AI debug logs (local development artifacts)
.cursor/
.RandP/
.agent/

# PyInstaller build artifacts
dist/
build/
# PyInstaller 自动生成的中间 .spec 忽略，但手写的 boss.spec 必须入库
*.spec
!boss.spec

#docs
docs/git